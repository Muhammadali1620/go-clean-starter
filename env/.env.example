# ===================== App Config =====================
APP_ENV=development
PORT=8080
MAX_BODY_SIZE=10M
MAX_RATE_LIMIT=60

# ===================== CORS =====================
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ===================== PostgreSQL =====================
DB_HOST=postgres-db
DB_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=50
DB_CONN_MAX_LIFETIME_MINUTES=60
DB_CONN_MAX_IDLE_TIME_MINUTES=15

# ===================== Redis =====================
REDIS_HOST=redis-db
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===================== JWT Security =====================
JWT_SECRET=super_secret_jwt_key_change_in_production_random_string_32_bytes
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ===================== Dev / Swagger Basic Auth =====================
DEV_USER=admin
DEV_PASSWORD=1

# ===================== Telegram Bot =====================
# Get token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Update mode: "polling" (for local/standalone) or "webhook" (for prod HTTP)
BOT_UPDATE_MODE=polling
BOT_WEBHOOK_URL=https://api.yourdomain.com/api/v1/tg/webhook
BOT_SECRET_PATH=super_random_secret_string_for_webhook
